# Site-controlled example, not an active configuration. Unique port/token per user.
APEXA_WEB_PORT=8101
APEXA_WEB_HOSTS=alice-apexa.example.edu
APEXA_WEB_ORIGINS=https://alice-apexa.example.edu
APEXA_WEB_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_BACKEND_TOKEN
APEXA_OPERATOR_ID=alice@example.edu
APEXA_PROPOSAL_ID=proposal-123
APEXA_DATA_ROOTS=/data/proposal-123:/var/lib/apexa-alice/uploads
APEXA_LLM_PRESET=custom
APEXA_LLM_MODE=proxy
APEXA_LLM_STRICT=1
APEXA_LLM_BASE_URL=https://llm.example.edu/v1
ARGO_MODEL=REPLACE_WITH_APPROVED_MODEL_ID
# Supply credentials through this protected environment file or OS keyring.
# Never put an actual key in this repository.
APEXA_NETWORK=internal
APEXA_EPICS_WRITE_PVS=
APEXA_EPICS_STOP_PVS=
APEXA_ALLOW_UNSANDBOXED_COMMANDS=0
